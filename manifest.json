{
  "manifest_version": 3,
  "name": "Discord Notifier for Stack",
  "version": "1.0.0",
  "description": "Delivers Discord web notifications as system notifications and keeps Discord tabs awake.",
  "permissions": ["notifications", "tabs"],
  "host_permissions": [
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://cdn.discordapp.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*", "https://ptb.discord.com/*", "https://canary.discord.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://discord.com/*", "https://ptb.discord.com/*", "https://canary.discord.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Discord Notifier" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
